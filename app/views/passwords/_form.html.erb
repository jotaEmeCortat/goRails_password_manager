
<div>
	<%= form_with model: password do |form| %>
		<% if form.object.errors.any? %>
			<% form.object.errors.full_messages.each do |message| %>
				<div>
					<%= message %>
				</div>
			<% end %>
		<% end %>

		<div class="flex flex-col mb-4">
			<%= form.label :url %>
			<%= form.url_field :url %>
		</div>

		<div class="flex flex-col mb-4">
			<%= form.label :username %>
			<%= form.text_field :username %>
		</div>

		<div class="flex flex-col mb-4">
			<%= form.label :password %>
			<%= form.password_field :password %>
		</div>

		<div class="flex justify-between items-center">
			<%= form.submit class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4" %>
			<% if form.object.persisted? %>
				<%= button_tag "Delete",
					form: "delete_password",
					class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4"
				%>
			<% end %>
		</div>
	<% end %>

	<%= form_with model: password,
		method: :delete, id: "delete_password",
		data: { turbo_confirm: "Are you sure?" }
	%>
</div>
