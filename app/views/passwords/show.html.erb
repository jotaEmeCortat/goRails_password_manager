<div class="mb-4 flex justify-between items-center">
	<%= link_to "Back", root_path %>
	<%= link_to "Edit", edit_password_path(@password) if @password.editable?(current_user) %>
</div>

<h3 class="my-0 mb-2">Credentials</h3>

<h6 class="mb-0 text-xs">Username / Email</h6>
<pre class="m-0 p-0 w-full bg-transparent">
	<code class="flex w-full items-center justify-between bg-slate-900 m-0 p-2 text-sm">
		<span class="truncate">
			<%= @password.username %>
		</span>
		<%= button_tag "Copy",
			class: "p-2 font-semibold",
			data: {
				controller: "clipboard",
				action: "click->clipboard#copy",
				clipboard_content_value: @password.username
			}
		%>
	</code>
</pre>

<h6 class="text-xs">Password</h6>
<pre class="m-0 p-0 w-full bg-transparent">
	<code class="flex w-full items-center justify-between bg-slate-900 m-0 p-2 text-sm">
		<span class="truncate">
			<%= @password.password %>
		</span>
		<%= button_tag "Copy",
			class: "p-2 font-semibold",
			data: {
				controller: "clipboard",
				action: "click->clipboard#copy",
				clipboard_content_value: @password.password
			}
		%>
	</code>
</pre>

<div class="mb-4 mt-8 flex justify-between items-center">
	<h3 class="my-0 mb-2">Shared With</h3>
	<%= link_to "Add a user", new_password_share_path(@password) if @password.shareable?(current_user) %>
</div>

<div class="grid grid-cols-[2fr_1fr_120px] gap-4">
	<span class="text-xs w-full">Email</span>
	<span class="text-xs text-start">Role</span>
	<span class="text-xs">Action</span>
</div>
<% @password.shared_user_passwords.each do |user_password| %>
	<div class="grid grid-cols-[2fr_1fr_120px] gap-4">
		<span class="truncate"><%= user_password.user.email %></span>
		<span class="text-left justify-self-start text-slate-600"><%= user_password.role %></span>
		<span class="text-left justify-self-start">
			<% if @password.shareable?(current_user) %>
				<%= button_to "Remove",
					password_share_path(@password, user_password),
					method: :delete,
					data: { turbo_confirm: "Are you sure?" },
					class: "text-sm font-semibold text-red-500 hover:text-red-600"
				%>
			<% end %>
		</span>
	</div>
<% end %>
